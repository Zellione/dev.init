#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="$HOME/wallpaper"
STATE_DIR="$HOME/.local/state/zell-shell"
CURRENT="$STATE_DIR/current-wallpaper"
MONITORS=(DP-3 DP-2)

usage() {
    echo "Usage: zell-wallpaper <filename|--current|--list>" >&2
    exit 2
}

case "${1:-}" in
    --current)
        if [[ -L "$CURRENT" ]]; then
            readlink -f "$CURRENT"
        else
            echo "No wallpaper selected" >&2
            exit 1
        fi
        exit 0
        ;;
    --list)
        find "$WALLPAPER_DIR" -maxdepth 1 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' \
               -o -iname '*.png' -o -iname '*.webp' \) \
            -printf '%f\n' | sort
        exit 0
        ;;
    "")
        usage
        ;;
esac

filename="$(basename -- "$1")"

if [[ "$filename" != "$1" ]]; then
    echo "Expected a filename inside $WALLPAPER_DIR" >&2
    exit 1
fi

case "${filename,,}" in
    *.jpg|*.jpeg|*.png|*.webp) ;;
    *)
        echo "Unsupported wallpaper format" >&2
        exit 1
        ;;
esac

wallpaper="$WALLPAPER_DIR/$filename"

if [[ ! -f "$wallpaper" || -L "$wallpaper" ]]; then
    echo "Wallpaper not found: $filename" >&2
    exit 1
fi

wallpaper="$(realpath -e -- "$wallpaper")"

for monitor in "${MONITORS[@]}"; do
    hyprctl hyprpaper wallpaper \
        "$monitor,$wallpaper,cover"
done

mkdir -p "$STATE_DIR"

temporary="$STATE_DIR/.current-wallpaper.$$"
trap 'rm -f -- "$temporary"' EXIT

ln -s -- "$wallpaper" "$temporary"
mv -Tf -- "$temporary" "$CURRENT"

echo "Wallpaper applied: $filename"
