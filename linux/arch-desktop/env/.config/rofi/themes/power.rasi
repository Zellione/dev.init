@import "launcher.rasi"

window {
    width: 420px;
    border: 2px;
    border-color: @border-color;
    border-radius: 12px;
    padding: 14px;
}

inputbar {
    padding: 10px 12px;
}

entry {
    placeholder: "";
}

listview {
    lines: 4;
    columns: 1;
    spacing: 6px;
    scrollbar: false;
}

element {
    padding: 12px 14px;
    border-radius: 8px;
}

element-icon {
    size: 0px;
}
