{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "agent": {
        "plan": {
            "tools": {
                "write": false,
                "edit": false,
                "patch": false,
                "bash": false
            }
        }
    },
    "mode": {
        "plan": {
            "model": "opencode-go/kimi-k2.6"
        },
        "build": {
            "model": "opencode-go/deepseek-v4-pro"
        }
    },
    "provider": {
        "local-wsl-llama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Local WSL Llama",
            "options": {
                "baseURL": "http://127.0.0.1:8001/v1"
            },
            "models": {
                "qwen36-27b": {
                    "tools": true,
                    "limit": {
                        "context": 64000,
                        "output": 4096
                    }
                },
                "qwen36-35b-a3b": {
                    "tools": true,
                    "limit": {
                        "context": 262144,
                        "output": 8192
                    }
                },
                "qwen25-coder-14b-instruct": {
                    "tools": true,
                    "limit": {
                        "context": 32768,
                        "output": 4096
                    }
                }
            }
        },
        "local-wsl-vllm": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Local WSL vLLM",
            "options": {
                "baseURL": "http://127.0.0.1:8001/v1"
            },
            "models": {
                "unsloth/Qwen3.6-27B-NVFP4": {
                    "tools": true,
                    "limit": {
                        "context": 110000,
                        "output": 8192
                    }
                }
            }
        },
        "Llama.cpp WSL": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Local Llama WSL 2",
            "options": {
                "baseURL": "http://127.0.0.1:8080/v1"
            },
            "models": {
                "unsloth/Qwen3.6-GGUF-MTP-27B": {
                    "name": "Local Qwen 3.6 MTP 27B GGUF",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 200000,
                        "output": 32768
                    },
                    "tool_call": true,
                    "reasoning": true
                }
            }
        }
    },
    "mcp": {
        "sonarqube": {
            "type": "local",
            "enabled": true,
            "command": [
                "docker",
                "run",
                "-i",
                "--rm",
                "-e",
                "SONARQUBE_TOKEN",
                "-e",
                "SONARQUBE_ORG",
                "mcp/sonarqube"
            ],
            "environment": {
                "SONARQUBE_TOKEN": "{file:./secrets/sq_token}",
                "SONARQUBE_ORG": "{file:./secrets/sq_company}"
            }
        }
    },
    "model": "qwen36-27b"
}
